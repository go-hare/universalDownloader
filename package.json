{
  "name": "universaldownloader",
  "version": "1.8.1",
  "description": "universalDownloader is an open-source API service that allows users to download media content from various platforms including YouTube, Spotify, Instagram, Facebook, Twitter, and more.",
  "main": "index.js",
  "bin": {
    "universal": "./cli.js"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node index.js",
    "cli": "node cli.js",
    "build:cli": "bun build --compile --target=bun-windows-x64 --outfile dist/universal.exe cli.js",
    "build:cli:mac": "bun build --compile --target=bun-darwin-arm64 --outfile dist/mac-arm64/universal cli.js",
    "build:cli:mac:x64": "bun build --compile --target=bun-darwin-x64 --outfile dist/mac-x64/universal cli.js",
    "build:cli:all": "npm run build:cli && npm run build:cli:mac && npm run build:cli:mac:x64",
    "dev": "nodemon index.js",
    "setup:downloader": "node scripts/setup-downloader.js",
    "setup:ffmpeg": "node scripts/setup-ffmpeg.js",
    "verify:downloads": "node scripts/verify-downloads.js",
    "verify:hd": "node scripts/verify-hd-downloads.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "metadownloader": "^1.0.0",
    "morgan": "^1.10.1",
    "qs": "^6.11.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
